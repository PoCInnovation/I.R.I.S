OPENAI_API_KEY=

# HoloLens live stream (default source for run_pipeline). URL may embed
# credentials. Leave unset if you only use --source webcam or --image.
IRIS_HOLOLENS_URL=https://user:pass@192.168.1.14/api/holographic/stream/live.mp4
# ffmpeg binary; default "ffmpeg" (must be on PATH). Set to a full path if not.
IRIS_FFMPEG_PATH=ffmpeg
# Stream resolution in pixels (must match the HoloLens output).
IRIS_HOLOLENS_WIDTH=1280
IRIS_HOLOLENS_HEIGHT=720
